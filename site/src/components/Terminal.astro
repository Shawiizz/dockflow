---
// A terminal replaying a deploy, line by line, as the CLI prints it.
interface Line {
	text: string;
	kind?: 'cmd' | 'dim' | 'ok' | 'plan' | 'add' | 'mod' | 'rel' | 'live';
}

interface Props {
	title?: string;
	lines: Line[];
}

const { title = 'dockflow', lines } = Astro.props;

const escape = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// one string: whitespace from the template would show inside <pre>
const html = lines
	.map((l, i) => {
		const prompt = l.kind === 'cmd' ? '<span class="prompt">$ </span>' : '';
		return `<span class="line ${l.kind ?? ''}" style="--i: ${i}">${prompt}${escape(l.text)}</span>`;
	})
	.join('\n');
---

<figure class="not-content terminal" aria-label="Terminal output of a deploy">
	<div class="bar">
		<span class="dot"></span><span class="dot"></span><span class="dot"></span>
		<span class="title">{title}</span>
	</div>
	<pre><code set:html={html} /></pre>
</figure>

<style>
	.terminal {
		margin: 0;
		border-radius: 0.9rem;
		border: 1px solid var(--df-border);
		background: linear-gradient(180deg, rgba(14, 20, 33, 0.96), rgba(9, 13, 22, 0.98));
		box-shadow:
			0 30px 80px -30px rgba(var(--df-glow), 0.55),
			inset 0 1px 0 rgba(255, 255, 255, 0.04);
		overflow: hidden;
		text-align: start;
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.65rem 0.9rem;
		border-bottom: 1px solid rgba(148, 170, 205, 0.12);
	}

	.dot {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: #ff5f57;
	}
	.dot:nth-child(2) {
		background: #febc2e;
	}
	.dot:nth-child(3) {
		background: #28c840;
	}

	.title {
		margin-inline-start: 0.6rem;
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		color: #8b98ad;
	}

	pre {
		margin: 0;
		padding: 1rem 1.1rem 1.2rem;
		font-family: var(--sl-font-mono);
		font-size: clamp(0.72rem, 1.6vw, 0.84rem);
		line-height: 1.65;
		color: #c0cad9;
		background: transparent;
		border: none;
		overflow-x: auto;
	}

	pre :global(.line) {
		opacity: 0;
		animation: appear 0.25s ease forwards;
		animation-delay: calc(var(--i) * 0.32s + 0.3s);
	}

	@media (prefers-reduced-motion: reduce) {
		pre :global(.line) {
			opacity: 1;
			animation: none;
		}
	}

	@keyframes appear {
		from {
			opacity: 0;
			transform: translateY(3px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	pre :global(.prompt) {
		color: #3a9bff;
	}
	pre :global(.cmd) {
		color: #ffffff;
	}
	pre :global(.dim) {
		color: #6c7891;
	}
	pre :global(.ok) {
		color: #4ade80;
	}
	pre :global(.plan) {
		color: #ffffff;
		font-weight: 600;
	}
	pre :global(.add) {
		color: #4ade80;
	}
	pre :global(.mod) {
		color: #fbbf24;
	}
	pre :global(.rel) {
		color: #ffffff;
		font-weight: 600;
	}
	pre :global(.live) {
		color: #4ade80;
		font-weight: 600;
	}
</style>
