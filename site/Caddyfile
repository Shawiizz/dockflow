# Plain HTTP: Dockflow's switch terminates TLS in front of this container.
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	@assets path /_astro/* /pagefind/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	file_server
	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
