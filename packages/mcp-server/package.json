{
  "name": "@dockflow-tools/mcp",
  "version": "1.0.1",
  "description": "MCP server for Dockflow - lets AI assistants search the docs, get examples and validate configuration for Docker Swarm and k3s",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "dockflow-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "node --import tsx --test \"src/__tests__/**/*.test.ts\"",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public"
  },
  "keywords": [
    "dockflow",
    "mcp",
    "model-context-protocol",
    "ai",
    "documentation",
    "kubernetes",
    "k3s"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Shawiizz/dockflow"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "yaml": "^2.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  }
}
