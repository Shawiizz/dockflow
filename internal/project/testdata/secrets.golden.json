{
  "name": "guide",
  "env": "production",
  "stack": "guide-production",
  "services": [
    {
      "name": "app",
      "strategy": "start-first",
      "replicas": 1,
      "spec": {
        "image": "ghcr.io/acme/app:1.4",
        "user": "1000",
        "mounts": [
          {
            "type": "bind",
            "source": "/run/dockflow/secrets/guide-production/api_token-6429a95f51ef",
            "target": "/etc/app/token",
            "read_only": true
          }
        ],
        "networks": [
          {
            "network": "guide-production_default",
            "aliases": [
              "app"
            ]
          }
        ],
        "restart": "unless-stopped",
        "resources": {}
      },
      "pull_policy": "missing",
      "drain": "30s",
      "health_grace": "10s"
    },
    {
      "name": "db",
      "strategy": "start-first",
      "replicas": 1,
      "spec": {
        "image": "postgres:17",
        "env": [
          "POSTGRES_PASSWORD_FILE=/run/secrets/db_password"
        ],
        "mounts": [
          {
            "type": "bind",
            "source": "/run/dockflow/secrets/guide-production/db_password-bd09562d9e13",
            "target": "/run/secrets/db_password",
            "read_only": true
          }
        ],
        "networks": [
          {
            "network": "guide-production_default",
            "aliases": [
              "db"
            ]
          }
        ],
        "restart": "unless-stopped",
        "resources": {}
      },
      "pull_policy": "missing",
      "drain": "30s",
      "health_grace": "10s"
    },
    {
      "name": "proxy",
      "strategy": "start-first",
      "replicas": 1,
      "spec": {
        "image": "nginx:1.27",
        "mounts": [
          {
            "type": "bind",
            "source": "/var/lib/dockflow/apps/guide-production/configs/site-c20e7f766bff",
            "target": "/etc/nginx/conf.d/default.conf",
            "read_only": true
          }
        ],
        "networks": [
          {
            "network": "guide-production_default",
            "aliases": [
              "proxy"
            ]
          }
        ],
        "restart": "unless-stopped",
        "resources": {}
      },
      "pull_policy": "missing",
      "drain": "30s",
      "health_grace": "10s"
    },
    {
      "name": "web",
      "strategy": "start-first",
      "replicas": 1,
      "spec": {
        "image": "guide/web",
        "networks": [
          {
            "network": "guide-production_default",
            "aliases": [
              "web"
            ]
          }
        ],
        "restart": "unless-stopped",
        "resources": {}
      },
      "pull_policy": "missing",
      "build": true,
      "drain": "30s",
      "health_grace": "10s"
    }
  ],
  "networks": [
    {
      "key": "default",
      "name": "guide-production_default"
    }
  ],
  "volumes": null,
  "files": [
    {
      "name": "api_token",
      "secret": true,
      "hash": "6429a95f51efdd8fac0b70eff4208e4a41f09cbbe33ea7fbd7fc247c40e07d40",
      "path": "/run/dockflow/secrets/guide-production/api_token-6429a95f51ef",
      "uid": 1000,
      "gid": 1000,
      "mode": 256
    },
    {
      "name": "db_password",
      "secret": true,
      "hash": "bd09562d9e13e6d4e42b58cef4db80abe88142e20cf339222331a3a3c564c490",
      "path": "/run/dockflow/secrets/guide-production/db_password-bd09562d9e13",
      "uid": 0,
      "gid": 0,
      "mode": 292
    },
    {
      "name": "site",
      "hash": "c20e7f766bff8b10cd187e5c5d01bd4e364f03f8587a04110b73a0ead4f54c4a",
      "path": "/var/lib/dockflow/apps/guide-production/configs/site-c20e7f766bff",
      "uid": 0,
      "gid": 0,
      "mode": 292
    }
  ]
}
