{
  "uploads": [
    {
      "Src": "vhost.conf",
      "Dest": "/etc/nginx/sites-enabled/shop-production-api.conf",
      "Mode": "644",
      "Plugin": "api"
    }
  ],
  "files": [
    "api/vhost.conf -rw-r--r--"
  ],
  "hooks": [
    {
      "phase": "after_deploy",
      "name": "api: check and reload nginx",
      "kind": "host",
      "command": "sudo nginx -t \u0026\u0026 sudo systemctl reload nginx",
      "timeout": "5m0s",
      "fatal": true,
      "plugin": "api",
      "if_changed": "/etc/nginx/sites-enabled/shop-production-api.conf"
    }
  ]
}
