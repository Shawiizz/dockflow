{
  "admin": {
    "listen": "unix//run/dockflow-switch/admin.sock"
  },
  "apps": {
    "http": {
      "servers": {
        "http": {
          "listen": [
            ":80"
          ],
          "routes": [
            {
              "@id": "dockflow.blog-staging.web.0",
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "selection_policy": {
                      "policy": "round_robin"
                    },
                    "try_duration": "2s"
                  },
                  "upstreams": [
                    {
                      "dial": "{file./run/dockflow-switch/up/blog-staging.web.0/0}"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "blog.test"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "abort": true,
                  "handler": "static_response"
                }
              ]
            }
          ]
        },
        "https": {
          "listen": [
            ":443"
          ],
          "routes": [
            {
              "@id": "dockflow.shop-production.api.0",
              "handle": [
                {
                  "handler": "rewrite",
                  "strip_path_prefix": "/api"
                },
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "selection_policy": {
                      "policy": "round_robin"
                    },
                    "try_duration": "2s"
                  },
                  "upstreams": [
                    {
                      "dial": "{file./run/dockflow-switch/up/shop-production.api.0/0}"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "shop.example.com"
                  ],
                  "path": [
                    "/api",
                    "/api/*"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "@id": "dockflow.shop-production.web.0",
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "load_balancing": {
                    "selection_policy": {
                      "policy": "round_robin"
                    },
                    "try_duration": "2s"
                  },
                  "upstreams": [
                    {
                      "dial": "{file./run/dockflow-switch/up/shop-production.web.0/0}"
                    },
                    {
                      "dial": "{file./run/dockflow-switch/up/shop-production.web.0/1}"
                    }
                  ]
                }
              ],
              "match": [
                {
                  "host": [
                    "shop.example.com",
                    "www.shop.example.com"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "abort": true,
                  "handler": "static_response"
                }
              ]
            }
          ]
        }
      }
    }
  }
}
