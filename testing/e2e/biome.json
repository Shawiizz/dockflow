{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "files": {
    "includes": ["**/*.ts"]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "suspicious": {
        "noExplicitAny": "error",
        "noDoubleEquals": "error",
        "noFallthroughSwitchClause": "error"
      },
      "correctness": {
        "noUnusedImports": "error",
        "noUnreachable": "error"
      }
    }
  }
}
